// Definiciones de Hardware 
#define LED_PORT     PORTD
#define LED_DDR      DDRD
#define LED_PIN      PD2              // Pin para los datos del WS2812B
#define LED_MASK     (1<<LED_PIN)

#define ANCHO        8
#define ALTO         8
#define N_LEDS       (ANCHO*ALTO)

