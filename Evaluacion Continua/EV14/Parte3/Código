#define F_CPU 16000000UL
#include <avr/io.h>
#include <util/delay.h>
#include <avr/eeprom.h>
#include <stdbool.h>
#include <stdint.h>

/*  LCD 8-bit */
#define LCD_DATA_PORT   PORTD
#define LCD_DATA_DDR    DDRD

#define LCD_CTL_PORT    PORTB
#define LCD_CTL_DDR     DDRB
#define LCD_RS_BIT      PB0
#define LCD_EN_BIT      PB1

static inline void lcd_en_pulse(void){
    LCD_CTL_PORT |=  (1<<LCD_EN_BIT);
    _delay_us(2);
    LCD_CTL_PORT &= ~(1<<LCD_EN_BIT);
    _delay_us(60);
}
static inline void lcd_write8(uint8_t b, uint8_t rs){
    if(rs) LCD_CTL_PORT |=  (1<<LCD_RS_BIT);
    else   LCD_CTL_PORT &= ~(1<<LCD_RS_BIT);
    LCD_DATA_PORT = b;
    lcd_en_pulse();
}
static inline void lcd_cmd(uint8_t c){ lcd_write8(c,0); }
static inline void lcd_data(uint8_t d){ lcd_write8(d,1); }

static void lcd_init(void){
    LCD_DATA_DDR = 0xFF;
    LCD_CTL_DDR  |= (1<<LCD_RS_BIT)|(1<<LCD_EN_BIT);
    _delay_ms(40);
    lcd_cmd(0x38);            // 8-bit, 2 lines, 5x8
    lcd_cmd(0x0C);            // display ON, cursor OFF
    lcd_cmd(0x06);            // entry mode
    lcd_cmd(0x01); _delay_ms(2); // clear
}
static void lcd_set_xy(uint8_t col, uint8_t row){
    lcd_cmd(0x80 | (row?0x40:0x00) | (col & 0x0F));
}
static void lcd_print(const char *s){ while(*s) lcd_data(*s++); }
static void lcd_print_uint(uint16_t v){
    char buf[6]; int i=5; buf[i]='\0';
    if(!v){ lcd_data('0'); return; }
    while(v && i){ buf[--i] = '0' + (v%10); v/=10; }
    lcd_print(&buf[i]);
}

/*  ADC (PC0/ADC0)  */
static void adc_init(void){
    ADMUX  = (1<<REFS0) | 0;                       // AVcc ref, canal ADC0
    ADCSRA = (1<<ADEN) | (1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0); // presc /128
    _delay_ms(2);
    ADCSRA |= (1<<ADSC); while(ADCSRA & (1<<ADSC));        // dummy
}
static inline uint16_t adc_once(void){
    ADCSRA |= (1<<ADSC);
    while(ADCSRA & (1<<ADSC));
    return ADC;    // 10 bits
}
static uint16_t adc_avg(uint8_t n){
    uint32_t acc=0;
    for(uint8_t i=0;i<n;i++){ acc += adc_once(); }
    return (uint16_t)(acc / n);
}

/*  Lógica común: teclas y estabilidad */
#define SAMPLES       8
#define STAB_N        4
#define STAB_DELT     6
#define KEY_TOL       50     // Tolerancia ajustada
#define IDLE_MARGIN   50     // Margen para "fuera de rango" (sin tecla)

static const char keymap[16] = {
    '1','2','3','A',
    '4','5','6','B',
    '7','8','9','C',
    '*','0','#','D'
};

/* Tabla de objetivos (ADC) por tecla — se carga/guarda en EEPROM */
static uint16_t adc_targets[16];

/* EEPROM */
#define EE_MAGIC_ADDR   0x00
#define EE_TABLE_ADDR   0x02
#define EE_MAGIC_VALUE  0x4B59  // "KY"

static bool eeprom_has_table(void){
    uint16_t magic = eeprom_read_word((uint16_t*)EE_MAGIC_ADDR);
    return (magic == EE_MAGIC_VALUE);
}
static void eeprom_load_table(uint16_t *dst){
    for(uint8_t i=0;i<16;i++)
        dst[i] = eeprom_read_word((uint16_t*)(EE_TABLE_ADDR + 2*i));
}
static void eeprom_save_table(const uint16_t *src){
    for(uint8_t i=0;i<16;i++)
        eeprom_write_word((uint16_t*)(EE_TABLE_ADDR + 2*i), src[i]);
    eeprom_write_word((uint16_t*)EE_MAGIC_ADDR, EE_MAGIC_VALUE);
}

/* estabilidad simple */
static uint16_t read_stable_adc(void){
    uint16_t last = adc_avg(SAMPLES);
    uint8_t ok=0;
    while(ok < STAB_N){
        _delay_ms(2);
        uint16_t v = adc_avg(SAMPLES);
        uint16_t d = (v>last)? (v-last) : (last-v);
        if(d <= STAB_DELT) ok++;
        else ok=0;
        last = v;
    }
    return last;
}

/* rango válido (min/max) calculado desde la tabla */
static uint16_t KMIN=0, KMAX=1023;
static void update_range_from_table(void){
    KMIN=1023; KMAX=0;
    for(uint8_t i=0;i<16;i++){
        if(adc_targets[i] < KMIN) KMIN = adc_targets[i];
        if(adc_targets[i] > KMAX) KMAX = adc_targets[i];
    }
}

/* devuelve índice [0..15] o -1 si no hay tecla/indefinido */
static int8_t key_from_adc(uint16_t val){
    if(val + IDLE_MARGIN < KMIN || val > KMAX + IDLE_MARGIN)
        return -1;  // fuera de rango -> sin tecla
    uint16_t best=0xFFFF; int8_t idx=-1;
    for(uint8_t i=0;i<16;i++){
        uint16_t t=adc_targets[i];
        uint16_t d=(val>t)?(val-t):(t-val);
        if(d<best){ best=d; idx=i; }
    }
    return (best<=KEY_TOL) ? idx : -1;
}

/* UI LCD: escritura normal, backspace, clear */
static uint8_t cur_c=0, cur_r=0;
static void lcd_home_clear(void){
    lcd_cmd(0x01); _delay_ms(2); cur_c=0; cur_r=0; lcd_set_xy(0,0);
}
static void lcd_put_adv(char c){
    if(c=='\n'){ cur_c=0; cur_r^=1; lcd_set_xy(cur_c,cur_r); return; }
    lcd_data(c);
    if(++cur_c>=16){
        cur_c=0; cur_r^=1; lcd_set_xy(cur_c,cur_r);
        if(cur_r==0){ lcd_cmd(0x01); _delay_ms(2); }
    }
}
static void lcd_backspace(void){
    if(cur_c==0 && cur_r==0) return;
    if(cur_c==0){ cur_r=0; cur_c=15; } else cur_c--;
    lcd_set_xy(cur_c,cur_r); lcd_data(' '); lcd_set_xy(cur_c,cur_r);
}

/* Calibración en LCD  */
/* Para empezar calibración manual en cualquier momento, mantener '*' ~2 s */
static void do_calibration_lcd(void){
    lcd_home_clear();
    lcd_print("Calibracion");
    _delay_ms(800);

    for(uint8_t i=0;i<16;i++){
        lcd_home_clear();
        lcd_print("Cal tecla: ");
        lcd_data(keymap[i]);
        lcd_set_xy(0,1); lcd_print("Mantener... ADC=");

        /* esperar pulsacion (se detecta por cambio estable respecto al reposo)
           Si tu reposo esta alto (?1023), basta con esperar a que baje. */
        uint16_t v=0;
        while(1){
            v = read_stable_adc();
            if(!(v + IDLE_MARGIN < KMIN || v > KMAX + IDLE_MARGIN) || v < 1000){
                // presionada (heuristica robusta)
                break;
            }
        }

        // promediar estable mientras mantienes la tecla
        v = read_stable_adc();
        adc_targets[i] = v;

        // feedback
        lcd_set_xy(15-4,1);  // deja 4 espacios al final
        lcd_print_uint(v); lcd_print("   ");

        // esperar a soltar
        while(1){
            uint16_t r = read_stable_adc();
            if(r + IDLE_MARGIN < KMIN || r > KMAX + IDLE_MARGIN) break;
            _delay_ms(10);
        }
        _delay_ms(150);
    }

    eeprom_save_table(adc_targets);
    update_range_from_table();

    lcd_home_clear();
    lcd_print("Tabla guardada");
    lcd_set_xy(0,1); lcd_print("EEPROM OK");
    _delay_ms(800);
    lcd_home_clear();
}

/* ========================= MAIN ========================= */
int main(void){
    adc_init();
    lcd_init();

    lcd_set_xy(0,0); lcd_print("Listo teclado");

    if(eeprom_has_table()){
        eeprom_load_table(adc_targets);
        update_range_from_table();
        lcd_set_xy(0,1); lcd_print("Tabla EEPROM");
        _delay_ms(600);
    }else{
        /* Primera vez: pre-rango para detectar reposo alto durante cal */
        KMIN=400; KMAX=990;  // arranque conservador
        do_calibration_lcd();
    }

    lcd_home_clear();                 // espacio para escribir
    bool pressed=false; int8_t last=-1;
    uint16_t hold_cnt=0;

    while(1){
        uint16_t v = read_stable_adc();
        int8_t idx = key_from_adc(v);

        // Mostrar valor del ADC en el LCD
        lcd_home_clear();
        lcd_print("ADC: ");
        lcd_print_uint(v);  
        _delay_ms(1000);  

        if(idx<0){                  
            pressed=false; last=-1; hold_cnt=0;
            continue;
        }

        // confirmación (debounce)
        _delay_ms(20);
        uint16_t v2 = read_stable_adc();
        int8_t idx2 = key_from_adc(v2);
        if(idx2 != idx) continue;

        // manejo de pulsación única
        if(!pressed || idx!=last){
            char k = keymap[idx];

            // atajo: mantener '*' ~2 s -> calibración
            if(k=='*'){
                hold_cnt=0;
                // mientras siga presionada
                while(key_from_adc(read_stable_adc())==idx){
                    _delay_ms(10);
                    if(++hold_cnt >= 200){ // ~2 s
                        do_calibration_lcd();
                        lcd_home_clear();
                        break;
                    }
                }
                if(hold_cnt>=200){ pressed=false; last=-1; continue; }
                // si fue rápida, tratar como "clear"
                lcd_home_clear();
                pressed=true; last=idx;
                continue;
            }

            if(k=='#'){ lcd_backspace(); }
            else { lcd_put_adv(k); }

            pressed=true; last=idx;

           
            do{
                _delay_ms(10);
                v2 = read_stable_adc();
            }while(key_from_adc(v2)==idx);
            pressed=false; last=-1; hold_cnt=0;
        }
    }
    // return 0;
}
